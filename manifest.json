{
  "manifest_version": 3,
  "name": "VeeVee Watch Party Bridge",
  "version": "4.0",
  "description": "Universal VOD Bridge for VeeVee Watch Party (Netflix M7375-Safe Cadmium API + Disney+, HBO Max, Prime Video Shadow-DOM Engine).",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
