{
  "manifest_version": 3,
  "name": "VeeVee Watch Party Bridge",
  "version": "5.0",
  "description": "Universal VOD Bridge v5.0 for VeeVee Watch Party (Netflix Cadmium API + Disney+, HBO Max, Prime Video Audio/Subtitle DOM & Shadow-DOM Controller).",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
