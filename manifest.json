{
  "manifest_version": 3,
  "name": "VeeVee Watch Party Bridge",
  "version": "1.0",
  "description": "Zdalny mostek sterujący odtwarzaczem dla VeeVee (Netflix, Disney+, YouTube)",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.disneyplus.com/*",
    "https://*.youtube.com/*",
    "https://*.max.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.youtube.com/*",
        "https://*.max.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
