{
  "manifest_version": 3,
  "name": "VeeVee Watch Party Bridge",
  "version": "3.0",
  "description": "M7375-Safe VOD Bridge for VeeVee Watch Party (Netflix Cadmium API, Disney+, Max, Prime Video, Audio & Subtitles).",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.max.com/*",
        "https://*.primevideo.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
